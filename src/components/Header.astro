---
import { getAbsoluteLocaleUrl } from "astro:i18n";
// import Navigation from "./Navigation.astro";
import ThemeSwitcher from "./ThemeSwitcher.svelte";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { locale } = Astro.locals;

const strings = {
  en: {
    blog: "BLOG",
    theme: { light: "light mode", dark: "dark mode", changeTo: "Change to" },
  },
  sk: {
    blog: "BLOG",
    theme: { light: "svetlý", dark: "tmavý", changeTo: "Zmeniť vzhľad na" },
  },
};
const t = strings[locale as keyof typeof strings];
---

<header>
  <a href={getAbsoluteLocaleUrl(locale, "")}>Vladimír Kovalský</a>
  <!-- <Navigation /> -->
  <LanguageSwitcher />
  <ThemeSwitcher client:load labels={t.theme} />
</header>

<style>
  @keyframes header-shrink {
    to {
      padding: var(--space-xs) var(--space-m);
      border-color: var(--color-border);
    }
  }

  @keyframes logo-shrink {
    to {
      font-size: var(--text-m);
    }
  }

  header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    padding: clamp(1rem, 0.826rem + 0.87vw, 1.5rem)
      clamp(1.5rem, 0.63rem + 4.348vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3xs);
    background-color: var(--color-bg);
    border-block-end: 1px solid transparent;
    animation: header-shrink auto linear both;
    animation-timeline: scroll(block root);
    animation-range: 0 6rem;

    > a:first-child {
      margin-inline-end: auto;
      text-decoration: none;
      font-size: var(--text-xl);
      font-family: var(--font-heading);
      letter-spacing: var(--space-3xs);
      animation: logo-shrink auto linear both;
      animation-timeline: scroll(block root);
      animation-range: 0 6rem;

      @media screen and (width < 40rem) {
        font-size: var(--text-m);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header,
    header > a:first-child {
      animation: none;
    }
  }
</style>
