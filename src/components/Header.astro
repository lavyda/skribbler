---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import ThemeSwitcher from "./ThemeSwitcher.svelte";

const locale = Astro.locals.locale;

const strings = {
  en: {
    blog: "BLOG",
    theme: { system: "System", light: "Light", dark: "Dark", themes: "Themes" },
  },
  sk: {
    blog: "BLOG",
    theme: {
      system: "Systém",
      light: "Svetlý",
      dark: "Tmavý",
      themes: "Vzhľad",
    },
  },
};
const t = strings[locale as keyof typeof strings];
---

<header>
  <a href={getAbsoluteLocaleUrl(locale, "")}>VLADIMÍR KOVALSKÝ</a>
  <nav>
    <ul>
      <!-- <li><a href={getAbsoluteLocaleUrl(locale, "blog")}>{t.blog}</a></li> -->
    </ul>
  </nav>
  <ThemeSwitcher client:load labels={t.theme} />
</header>

<style>
  @keyframes header-shrink {
    to {
      padding: var(--space-xs) var(--space-m);
      border-color: var(--color-border);
    }
  }

  @keyframes logo-shrink {
    to {
      font-size: var(--text-m);
    }
  }

  header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    padding: clamp(1rem, 0.826rem + 0.87vw, 1.5rem)
      clamp(1.5rem, 0.63rem + 4.348vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    background-color: var(--color-bg);
    border: 1px solid transparent;
    animation: header-shrink auto linear both;
    animation-timeline: scroll(block root);
    animation-range: 0 6rem;

    > a:first-child {
      text-decoration: none;
      font-size: var(--text-xl);
      animation: logo-shrink auto linear both;
      animation-timeline: scroll(block root);
      animation-range: 0 6rem;
    }

    nav {
      margin-inline-start: auto;

      ul {
        display: flex;
        flex-direction: row;
        list-style-type: none;
        gap: var(--space-l);

        a {
          text-decoration: none;

          &:hover,
          &:active,
          &:focus-visible {
            text-decoration: underline;
          }
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header,
    header > a:first-child {
      animation: none;
    }
  }
</style>
