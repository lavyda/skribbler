---
import Fill from "@/layouts/Fill.astro";
import ConfusedGuy from "@/lib/ui/ConfusedGuy.astro";
import Button from "@/lib/ui/Button.svelte";

const { locale, locales } = Astro.locals;

const strings: Record<string, { text: string; home: string }> = {
  en: { text: "This page doesn't exist.", home: "Back home" },
  sk: { text: "Táto stránka neexistuje.", home: "Späť domov" },
};
---

<Fill title="404 · Vladimír Kovalský" alternates={{}} suggestLocale={false}>
  <div class="layout">
    <ConfusedGuy />
    {
      locales.map((l) => (
        <div class="not-found" data-locale={l} hidden={l !== locale}>
          <h1>404</h1>
          <p>{strings[l].text}</p>
          <Button variant="secondary" link href="/">
            {strings[l].home}
          </Button>
        </div>
      ))
    }
  </div>
</Fill>

<script>
  import { preferred, siteLocales } from "@/lib/localePreference";

  // The static 404 is rendered once, so the language is resolved here.
  // The URL is never changed: a path without a locale prefix is simply a 404.
  const blocks = document.querySelectorAll<HTMLElement>("[data-locale]");
  const [first] = location.pathname.split("/").filter(Boolean);
  const lang = siteLocales().includes(first) ? first : preferred();

  if (lang) {
    for (const el of blocks) el.hidden = el.dataset.locale !== lang;
  }
</script>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl) var(--space-2xl);
    padding-block-start: var(--space-3xl);

    @media screen and (width < 40rem) {
      padding-block-start: 0;
    }
  }

  .not-found {
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    text-align: center;

    &[hidden] {
      display: none;
    }
  }

  h1 {
    font-family: var(--font-monospace);
    font-size: var(--text-3xl);
    font-weight: var(--weight-normal);
    color: var(--color-accent);
  }

  p {
    color: var(--color-text-muted);
  }
</style>
