---
import { i18n } from "astro:config/server";
import Base from "@/layouts/Base.astro";
import {
  getListedGalleries,
  slugOf,
  type Locale,
} from "@/modules/gallery/gallery";
import Chip from "@/lib/ui/Chip.svelte";
import Lightbox from "@/modules/gallery/Lightbox.astro";
import { dateFormatter } from "@/lib/dateTime";
import {
  COVER_WIDTHS,
  GRID_WIDTHS,
  imagekitSrcSet,
  imagekitUrl,
} from "@/lib/imagekit";

export async function getStaticPaths() {
  const locales = i18n?.locales ?? [];
  const groups = await Promise.all(
    locales.map(async (lang) => {
      const galleries = await getListedGalleries(lang as Locale);
      return galleries.map((gallery) => ({
        params: { lang, slug: slugOf(gallery) },
        props: { gallery },
      }));
    }),
  );
  return groups.flat();
}

const { gallery } = Astro.props;
const { locale } = Astro.locals;
const slug = slugOf(gallery);
const cover = gallery.data.photos[0];

const strings = {
  en: { updated: "Updated", photos: "photos" },
  sk: { updated: "Aktualizované", photos: "fotiek" },
};
const t = strings[locale];

const fmt = dateFormatter(locale);
---

<Base title={gallery.data.title}>
  <main>
    <img
      src={imagekitUrl(cover.src, { width: 1920 })}
      srcset={imagekitSrcSet(cover.src, COVER_WIDTHS)}
      sizes="100vw"
      fetchpriority="high"
      alt={cover.alt}
      class="cover"
      transition:name={`gallery-preview-cover-${slug}`}
    />

    <div class="seam" aria-hidden="true"></div>

    <header class="content" transition:name={`gallery-preview-meta-${slug}`}>
      <div class="divider" aria-hidden="true"><div></div></div>

      <h2 class="title">
        {gallery.data.title}
      </h2>

      <p class="description">{gallery.data.description}</p>

      <div class="meta">
        <time datetime={gallery.data.created.toISOString()}>
          {fmt.format(gallery.data.created)}
        </time>
        {
          gallery.data.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t.updated} {fmt.format(gallery.data.updated)}
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{gallery.data.photos.length} {t.photos}</span>
      </div>

      <ul class="tags">
        {
          gallery.data.tags.map((tag) => (
            <li>
              <Chip>{tag}</Chip>
            </li>
          ))
        }
      </ul>
    </header>

    <ul class="photos">
      {
        gallery.data.photos.map((photo, index) => (
          <li>
            <button type="button" data-lightbox-index={index}>
              <img
                src={imagekitUrl(photo.src, { width: 640 })}
                srcset={imagekitSrcSet(photo.src, GRID_WIDTHS)}
                sizes="(min-width: 30rem) 20rem, 100vw"
                loading="lazy"
                decoding="async"
                alt={photo.alt}
              />
              {photo.caption && <span class="caption">{photo.caption}</span>}
            </button>
          </li>
        ))
      }
    </ul>
  </main>

  <Lightbox photos={gallery.data.photos} />

  <style>
    .cover {
      display: block;
      inline-size: 100%;
      block-size: calc(20rem + var(--space-3xl) + var(--space-xl));
      object-fit: cover;
    }

    .seam {
      block-size: 1px;
      background-color: var(--color-border);
    }

    .photos {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
      gap: var(--space-m);
      padding: var(--space-xl);
      list-style-type: none;

      li {
        content-visibility: auto;
        contain-intrinsic-size: auto 20rem;
      }

      button {
        display: block;
        position: relative;
        inline-size: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        padding: 0;
        border: none;
        background: none;
        color: inherit;
        font: inherit;
        cursor: pointer;
        transition: transform 0.2s ease;

        &:hover {
          transform: scale(1.05);
          z-index: 1;
        }

        &:focus-visible {
          outline: 2px solid var(--color-accent);
          outline-offset: 2px;
        }

        &:hover .caption,
        &:focus-visible .caption {
          opacity: 1;
        }
      }

      img {
        display: block;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }

      .caption {
        position: absolute;
        inset-inline: 0;
        inset-block-end: 0;
        padding: var(--space-s);
        background: rgb(0 0 0 / 85%);
        color: #fff;
        text-align: start;
        font-family: var(--font-monospace);
        font-size: var(--text-xs);
        opacity: 0;
        transition: opacity 0.2s ease;
        pointer-events: none;
      }
    }

    .content {
      inline-size: min(var(--screen-xl), calc(100% - var(--space-xl) * 2));
      margin-inline: auto;
      margin-block-start: calc(-1 * var(--space-3xl));
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "meta tags"
        "divider divider"
        "title title"
        "description description";
      padding: var(--space-xl);
      row-gap: var(--space-m);
      column-gap: var(--space-l);
      background-color: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-m);

      @media screen and (width < 40rem) {
        grid-template-columns: 1fr;
        grid-template-areas:
          "meta"
          "tags"
          "divider"
          "title"
          "description";
      }
    }

    .meta {
      grid-area: meta;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs);
      color: var(--color-text-muted);
      font-family: var(--font-monospace);
      font-size: var(--text-xs);
    }

    .tags {
      grid-area: tags;
      display: flex;
      flex-wrap: wrap;
      align-items: start;
      gap: var(--space-2xs);
      padding-inline-start: 0;
      list-style-type: none;
    }

    .divider {
      grid-area: divider;

      div {
        block-size: 2px;
        inline-size: 3rem;
        background-color: var(--color-accent);
      }
    }

    .title {
      grid-area: title;
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      font-weight: var(--weight-normal);
    }

    .description {
      grid-area: description;
      color: var(--color-text-muted);
    }
  </style>
</Base>
