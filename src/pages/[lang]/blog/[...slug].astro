---
import { i18n } from "astro:config/server";
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import {
  getPosts,
  slugOf,
  readingTime,
  type Locale,
} from "@/modules/blog/blog";
import RelatedGalleries from "@/modules/blog/RelatedGalleries.astro";
import RelatedPosts from "@/modules/blog/RelatedPosts.astro";
import Chip from "@/lib/ui/Chip.svelte";
import { dateFormatter } from "@/lib/dateTime";
import { COVER_WIDTHS, imagekitSrcSet, imagekitUrl } from "@/lib/imagekit";

export async function getStaticPaths() {
  const locales = i18n?.locales ?? [];
  const groups = await Promise.all(
    locales.map(async (lang) => {
      const posts = await getPosts(lang as Locale);
      return posts.map((post) => ({
        params: { lang, slug: slugOf(post) },
        props: { post },
      }));
    }),
  );
  return groups.flat();
}

const { post } = Astro.props;
const { locale } = Astro.locals;
const { Content } = await render(post);

const strings = {
  en: { min: "min read", updated: "Updated" },
  sk: { min: "min čítania", updated: "Aktualizované" },
};
const t = strings[locale];

const fmt = dateFormatter(locale);
---

<Base title={post.data.title}>
  <main>
    {
      post.data.cover ? (
        <img
          src={imagekitUrl(post.data.cover, { width: 1920 })}
          srcset={imagekitSrcSet(post.data.cover, COVER_WIDTHS)}
          sizes="100vw"
          fetchpriority="high"
          alt={post.data.coverAlt ?? ""}
          class="cover"
          data-transition-role="hero-cover"
        />
      ) : (
        <div class="cover" aria-hidden="true" />
      )
    }

    <div class="seam" aria-hidden="true"></div>

    <header class="content" data-transition-role="hero-meta">
      <div class="divider" aria-hidden="true"><div></div></div>

      <h2 class="title">
        {post.data.title}
      </h2>

      <p class="description">{post.data.description}</p>

      <div class="meta">
        <time datetime={post.data.created.toISOString()}>
          {fmt.format(post.data.created)}
        </time>
        {
          post.data.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t.updated} {fmt.format(post.data.updated)}
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>
          {readingTime(post.body)}
          {t.min}
        </span>
      </div>

      <ul class="tags">
        {
          post.data.tags.map((tag) => (
            <li>
              <Chip>{tag}</Chip>
            </li>
          ))
        }
      </ul>
    </header>

    <article>
      <Content />
    </article>

    <div class="related">
      <RelatedGalleries post={post} />
      <RelatedPosts post={post} />
    </div>
  </main>

  <style>
    .cover {
      display: block;
      inline-size: 100%;
      block-size: calc(20rem + var(--space-3xl) + var(--space-xl));
      object-fit: cover;

      &[aria-hidden="true"] {
        block-size: calc(1rem + var(--space-3xl) + var(--space-xl));
      }
    }

    .seam {
      block-size: 1px;
      background-color: var(--color-border);
    }

    article {
      inline-size: min(var(--screen-reading), 100%);
      margin-inline: auto;
      padding-block: var(--space-xl);
      padding-inline: var(--space-l);
      line-height: var(--line-height-reading);
    }

    .related {
      inline-size: min(var(--screen-reading), 100%);
      margin-inline: auto;
      padding-inline: var(--space-l);
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);

      &:has(*) {
        padding-block: var(--space-xl);
        border-block-start: 1px solid var(--color-border);
      }
    }

    .content {
      /* Chrome can paint the preceding <img>'s replaced-element layer
         above a plain position:static sibling that overlaps it via
         negative margin, regardless of DOM order — position+z-index
         gives this box its own stacking context so it wins. */
      position: relative;
      z-index: 1;
      inline-size: min(var(--screen-reading), calc(100% - var(--space-l) * 2));
      margin-inline: auto;
      margin-block-start: calc(-1 * var(--space-3xl));
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "meta tags"
        "divider divider"
        "title title"
        "description description";
      padding: var(--space-l);
      row-gap: var(--space-m);
      column-gap: var(--space-l);
      background-color: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xs);

      @media screen and (width < 40rem) {
        grid-template-columns: 1fr;
        grid-template-areas:
          "meta"
          "tags"
          "divider"
          "title"
          "description";
      }
    }

    .meta {
      grid-area: meta;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs);
      color: var(--color-text-muted);
      font-family: var(--font-monospace);
      font-size: var(--text-xs);
    }

    .tags {
      grid-area: tags;
      display: flex;
      flex-wrap: wrap;
      align-items: start;
      gap: var(--space-2xs);
      padding-inline-start: 0;
      list-style-type: none;
    }

    .divider {
      grid-area: divider;

      div {
        block-size: 2px;
        inline-size: 3rem;
        background-color: var(--color-accent);
      }
    }

    .title {
      grid-area: title;
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      font-weight: var(--weight-semibold);
    }

    .description {
      grid-area: description;
      color: var(--color-text-muted);
    }

    article :global(h2),
    article :global(h3) {
      font-family: var(--font-heading);
      font-weight: var(--weight-normal);
      margin-block: var(--space-xl) var(--space-m);
    }

    article :global(p),
    article :global(ul),
    article :global(ol),
    article :global(blockquote),
    article :global(pre) {
      margin-block: var(--space-m);
    }

    article :global(ul),
    article :global(ol) {
      padding-inline-start: var(--space-l);
    }

    article :global(blockquote) {
      border-inline-start: 2px solid var(--color-accent);
      padding-inline-start: var(--space-m);
      color: var(--color-text-muted);
    }

    article :global(pre) {
      background-color: var(--color-surface);
      padding: var(--space-m);
      border-radius: var(--radius-xs);
      overflow-x: auto;
    }

    article :global(code) {
      font-family: var(--font-monospace);
      font-size: var(--text-s);
    }

    article :global(pre code) {
      font-size: inherit;
    }
  </style>
</Base>
