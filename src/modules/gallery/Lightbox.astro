---
import type { Photo } from "@/modules/gallery/gallery";

interface Props {
  id: string;
  photos: Photo[];
}

const { id, photos } = Astro.props;
const { locale } = Astro.locals;

// GLightbox hardcodes English for these, so they're applied from the script.
const strings = {
  en: {
    close: "Close",
    previous: "Previous photo",
    next: "Next photo",
    more: "See more",
  },
  sk: {
    close: "Zavrieť",
    previous: "Predchádzajúca fotka",
    next: "Nasledujúca fotka",
    more: "Zobraziť viac",
  },
};

const payload = JSON.stringify({ photos, labels: strings[locale] }).replace(
  /</g,
  "\\u003c",
);
---

<script type="application/json" data-lightbox-photos={id} set:html={payload} />

<script>
  type GLightbox = typeof import("glightbox");
  import type { Photo } from "@/modules/gallery/gallery";
  import { imagekitUrl, nearestWidth } from "@/lib/imagekit";

  // GLightbox and its CSS load on first hover, focus or click, so pages
  // with a gallery don't pay for them until someone shows interest.
  let library: Promise<GLightbox> | undefined;
  function loadLibrary() {
    library ??= Promise.all([
      import("glightbox"),
      import("@/styles/lightbox.css"),
    ]).then(([module]) => module.default);
    return library;
  }

  type Labels = { close: string; previous: string; next: string; more: string };

  const instances = new Set<ReturnType<GLightbox>>();

  function initLightbox(payload: HTMLScriptElement) {
    if (payload.dataset.lightboxInit) return;
    payload.dataset.lightboxInit = "true";

    const { photos, labels } = JSON.parse(payload.textContent!) as {
      photos: Photo[];
      labels: Labels;
    };

    // One viewer per gallery, created on first open and reused after. A
    // fresh instance per open raced the previous one's close timers, which
    // clear shared state on <body> and killed the new viewer.
    let viewer: ReturnType<GLightbox> | undefined;
    async function open(index: number) {
      const GLightbox = await loadLibrary();
      if (!viewer) {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const width = nearestWidth(window.innerWidth * dpr);
        viewer = GLightbox({
          elements: photos.map((photo) => ({
            href: imagekitUrl(photo.src, { width }),
            type: "image",
            alt: photo.alt,
            description: photo.caption,
          })),
          loop: true,
          moreText: labels.more,
        });
        // The buttons are built on every open, so relabel each time.
        viewer.on("open", () => {
          document.querySelector(".gclose")?.setAttribute("aria-label", labels.close);
          document.querySelector(".gprev")?.setAttribute("aria-label", labels.previous);
          document.querySelector(".gnext")?.setAttribute("aria-label", labels.next);
        });
        instances.add(viewer);
      }
      viewer.openAt(index);
    }

    document
      .querySelectorAll<HTMLElement>(
        `[data-lightbox-target="${payload.dataset.lightboxPhotos}"]`,
      )
      .forEach((el) => {
        el.addEventListener("pointerenter", loadLibrary, { once: true });
        el.addEventListener("focus", loadLibrary, { once: true });
        el.addEventListener("click", () =>
          open(Number(el.dataset.lightboxIndex)),
        );
      });
  }

  // Page changes are client-side swaps, so this script runs only once.
  // page-load fires after each swap; use it to find the new page's galleries.
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLScriptElement>("script[data-lightbox-photos]")
      .forEach(initLightbox);
  });

  // Destroy viewers before the swap so they don't outlive their page.
  document.addEventListener("astro:before-swap", () => {
    instances.forEach((viewer) => viewer.destroy());
    instances.clear();
  });
</script>
