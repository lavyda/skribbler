---
import type { Photo } from "@/modules/gallery/gallery";
import Button from "@/lib/ui/Button.svelte";
import Icon from "@/lib/ui/Icon.svelte";
import X from "@/lib/ui/icons/X.svelte";
import ChevronLeft from "@/lib/ui/icons/ChevronLeft.svelte";
import ChevronRight from "@/lib/ui/icons/ChevronRight.svelte";

interface Props {
  id: string;
  photos: Photo[];
}

const { id, photos } = Astro.props;
const { locale } = Astro.locals;

const strings = {
  en: {
    close: "Close",
    previous: "Previous photo",
    next: "Next photo",
    loading: "Loading photo",
  },
  sk: {
    close: "Zavrieť",
    previous: "Predchádzajúca fotka",
    next: "Nasledujúca fotka",
    loading: "Načítava sa fotka",
  },
};
const t = strings[locale];

const payload = JSON.stringify(photos).replace(/</g, "\\u003c");
---

<dialog class="lightbox" data-lightbox-id={id}>
  <Button variant="ghost" icon aria-label={t.close} class="control close">
    <Icon glyph={X} size="1.25rem" />
  </Button>

  <figure class="frame">
    <img class="photo" alt="" />
    <div class="spinner" aria-hidden="true"></div>
    <p class="status" role="status" data-loading-text={t.loading}></p>

    <div class="below">
      <div class="nav">
        <Button
          variant="ghost"
          icon
          aria-label={t.previous}
          class="control prev"
        >
          <Icon glyph={ChevronLeft} size="1.25rem" />
        </Button>

        <Button variant="ghost" icon aria-label={t.next} class="control next">
          <Icon glyph={ChevronRight} size="1.25rem" />
        </Button>
      </div>

      <div class="meta">
        <p class="caption"></p>
        <p class="counter"></p>
      </div>
    </div>
  </figure>
</dialog>

<script type="application/json" data-lightbox-photos={id} set:html={payload} />

<script>
  import { withViewTransition } from "@/lib/transitions/viewTransition";
  import { imagekitUrl, nearestWidth } from "@/lib/imagekit";

  type Photo = { src: string; alt: string; caption?: string };

  // Astro bundles this <script> once per page regardless of how many
  // <Lightbox> instances are rendered, so it must find and wire up every
  // instance itself rather than assume a single dialog. Trigger elements
  // for a given instance are scattered wherever content chooses to embed
  // them (a related-gallery card, an inline photo in an article body, the
  // gallery's own grid) and aren't necessarily in photo order or complete,
  // so each one carries its real photo index explicitly rather than
  // relying on DOM position.
  //
  // The script tag itself only executes once per browser session: Astro's
  // router dedupes <script src> by URL across view-transition navigations,
  // and every <Lightbox> instance site-wide compiles to the same file. So
  // discovery has to happen on astro:page-load (fired on the initial load
  // and again after every swap) rather than once at the top level, or
  // dialogs introduced by later navigations never get wired up. Each
  // dialog is guarded against re-init since astro:page-load can also fire
  // for a dialog that survived a swap unchanged.
  function initLightbox(dialog: HTMLDialogElement) {
    if (dialog.dataset.lightboxInit) return;
    dialog.dataset.lightboxInit = "true";

    const id = dialog.dataset.lightboxId!;
    const transitionName = `lightbox-photo-${id}`;

    const img = dialog.querySelector<HTMLImageElement>(".photo")!;
    const status = dialog.querySelector<HTMLParagraphElement>(".status")!;
    const caption = dialog.querySelector<HTMLParagraphElement>(".caption")!;
    const counter = dialog.querySelector<HTMLParagraphElement>(".counter")!;
    const closeButton = dialog.querySelector<HTMLButtonElement>(".close")!;
    const prevButton = dialog.querySelector<HTMLButtonElement>(".prev")!;
    const nextButton = dialog.querySelector<HTMLButtonElement>(".next")!;

    const payload = document.querySelector<HTMLScriptElement>(
      `script[data-lightbox-photos="${id}"]`,
    )!;
    const photos: Photo[] = JSON.parse(payload.textContent!);

    const thumbnails = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        `[data-lightbox-target="${id}"]`,
      ),
    );

    let index = 0;

    // Only one element may carry the shared name at a time, or the browser
    // rejects the transition as a duplicate view-transition-name. Scoped
    // per instance so two lightboxes open in sequence never fight over it.
    let tagged: HTMLElement | null = null;
    function tag(el: HTMLElement) {
      if (tagged && tagged !== el) tagged.style.viewTransitionName = "";
      el.style.viewTransitionName = transitionName;
      tagged = el;
    }

    function lightboxSrc(photo: Photo) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const width = nearestWidth(window.innerWidth * dpr);
      return imagekitUrl(photo.src, { width });
    }

    // The spinner's own CSS transition-delay decides whether this becomes
    // visible at all — fast loads never show it.
    function setLoading(loading: boolean) {
      if (loading) {
        dialog.dataset.loading = "true";
        status.textContent = status.dataset.loadingText ?? "";
      } else {
        delete dialog.dataset.loading;
        status.textContent = "";
      }
    }

    function preload(i: number) {
      const image = new Image();
      image.fetchPriority = "low";
      image.decoding = "async";
      image.src = lightboxSrc(photos[i]!);
      image.decode().catch(() => {});
    }

    // decode() is preferred (it guarantees the image is actually decoded,
    // not just downloaded, so the reveal never janks) but some browsers —
    // e.g. Chrome deprioritizing a backgrounded tab — never settle its
    // promise even once the image has fully loaded. Give it a grace period
    // after `load` fires, then treat "loaded" as good enough rather than
    // hang.
    function whenReady(loader: HTMLImageElement): Promise<void> {
      return new Promise((resolve) => {
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          resolve();
        };
        loader.decode().then(finish, finish);
        const afterLoad = () => setTimeout(finish, 300);
        if (loader.complete) afterLoad();
        else {
          loader.addEventListener("load", afterLoad, { once: true });
          loader.addEventListener("error", finish, { once: true });
        }
      });
    }

    // Guards against rapid next/prev clicks: a stale in-flight decode is
    // left to finish (harmless, the bytes get cached) but never reaches the
    // DOM.
    let renderToken = 0;

    // withTransition=false skips the View Transition for the reveal — used
    // by open()'s first photo, where the dialog already ran its own
    // transition a moment earlier. Firing a second root-level transition
    // right after (while the spinner is still mid-fade) visibly collided
    // with it. The spinner's own opacity fade-out is enough of a reveal on
    // its own: the photo is already decoded and paints instantly underneath
    // as it fades away.
    async function navigateTo(i: number, withTransition = true) {
      const token = ++renderToken;
      const photo = photos[i]!;
      setLoading(true);
      const loader = new Image();
      loader.fetchPriority = "high";
      loader.src = lightboxSrc(photo);
      await whenReady(loader);
      if (token !== renderToken) return;
      setLoading(false);
      index = i;
      preload((index + 1) % photos.length);
      preload((index - 1 + photos.length) % photos.length);
      const apply = () => {
        img.src = loader.src;
        img.alt = photo.alt;
        caption.textContent = photo.caption ?? "";
        counter.textContent = `${index + 1} / ${photos.length}`;
      };
      if (withTransition) withViewTransition(apply);
      else apply();
    }

    function open(i: number, thumbnail?: HTMLElement) {
      const thumbImg = thumbnail?.querySelector("img");
      if (thumbImg) tag(thumbImg);
      // Opens immediately — the morph plays right away instead of waiting
      // on the photo, which is what leaves the frame available to show a
      // spinner. Clear any photo left over from a previous session first,
      // or a reopen would show it until the new one finishes loading.
      // navigateTo() is called from *inside* this callback, not after it —
      // startViewTransition doesn't guarantee the callback runs
      // synchronously, and for an already-cached photo navigateTo can
      // otherwise finish and paint the real photo before this clear even
      // runs, which then wipes it out.
      withViewTransition(() => {
        img.src = "";
        img.alt = "";
        caption.textContent = "";
        counter.textContent = "";
        dialog.showModal();
        tag(img);
        navigateTo(i, false);
      });
    }

    function close() {
      const thumbImg = thumbnails
        .find((t) => Number(t.dataset.lightboxIndex) === index)
        ?.querySelector("img");
      withViewTransition(() => {
        dialog.close();
        if (thumbImg) tag(thumbImg);
      });
    }

    function go(delta: number) {
      navigateTo((index + delta + photos.length) % photos.length);
    }

    thumbnails.forEach((thumbnail) => {
      const i = Number(thumbnail.dataset.lightboxIndex);
      thumbnail.addEventListener("click", () => open(i, thumbnail));
    });

    closeButton.addEventListener("click", close);
    prevButton.addEventListener("click", () => go(-1));
    nextButton.addEventListener("click", () => go(1));

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      close();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") go(-1);
      else if (event.key === "ArrowRight") go(1);
    });
  }

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLDialogElement>(".lightbox")
      .forEach(initLightbox);
  });
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding-block: var(--space-2xl);
    padding-inline: calc(var(--space-3xl) + var(--space-s));
    border: none;
    background: none;
    color: var(--color-text);

    &[open] {
      display: flex;
    }

    &::backdrop {
      background-color: light-dark(rgb(255 255 255 / 94%), rgb(0 0 0 / 94%));
    }
  }

  .frame,
  .below,
  .nav {
    display: contents;
  }

  .photo {
    display: block;
    /* Keeps a sane morph target and a place for the spinner while src is
       cleared between open() and the first reveal — an empty img has no
       intrinsic size and would otherwise collapse to nothing. */
    min-inline-size: 12rem;
    min-block-size: 12rem;
    max-inline-size: 100%;
    max-block-size: calc(100vh - var(--space-3xl) * 2);
    object-fit: contain;
    border-radius: var(--radius-2xs);
  }

  .spinner {
    position: absolute;
    inset: 0;
    margin: auto;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--color-text) 25%, transparent);
    border-block-start-color: var(--color-text);
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }

  .lightbox[data-loading] .spinner {
    opacity: 1;
    transition-delay: 200ms;
    animation: lightbox-spin 800ms linear infinite;
  }

  @keyframes lightbox-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[data-loading] .spinner {
      animation: lightbox-pulse 1200ms ease-in-out infinite;
    }
  }

  @keyframes lightbox-pulse {
    50% {
      opacity: 0.4;
    }
  }

  .status {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .lightbox :global(.control) {
    position: absolute;
  }

  .lightbox :global(.close) {
    inset-block-start: var(--space-l);
    inset-inline-end: var(--space-l);
  }

  .lightbox :global(.prev) {
    inset-inline-start: var(--space-l);
  }

  .lightbox :global(.next) {
    inset-inline-end: var(--space-l);
  }

  .meta {
    position: absolute;
    inset-block-end: var(--space-l);
    inset-inline: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    text-align: center;
    font-family: var(--font-monospace);
    font-size: var(--text-xs);
    color: var(--color-text-muted);

    .caption:empty {
      display: none;
    }
  }

  @media screen and (width < 40rem) {
    .lightbox {
      padding-inline: var(--space-l);
      padding-block-end: var(--space-m);
    }

    .lightbox :global(.close) {
      inset-block-start: var(--space-s);
    }

    /* A block frame sized to the image would push .below past the
       viewport once the image ran tall enough. Grid rows reserve .below's
       row at its own auto height first, so it's always fully in view in
       the same spot; the image gets whatever's left over and shrinks to
       fit it instead. */
    .frame {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      place-items: center;
      position: relative;
      align-self: stretch;
      inline-size: 100%;
      block-size: 100%;
    }

    .photo {
      min-inline-size: 0;
      max-inline-size: 100%;
      max-block-size: 100%;
    }

    /* Constrains the abs-positioned spinner's containing block to the
       image's own grid row, or it'd center across the whole frame
       (image row + reserved .below row) instead of over the image. */
    .spinner {
      grid-row: 1;
    }

    /* .nav and .meta flatten so prev/next/caption/counter become direct
       grid items of .below — the only way to place .counter between the
       arrows while .caption keeps the full-width row above them. */
    .below {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      grid-template-rows: auto auto;
      column-gap: var(--space-m);
      row-gap: var(--space-m);
      align-items: center;
      justify-self: stretch;
      margin-block-start: var(--space-m);
    }

    .nav,
    .meta {
      display: contents;
    }

    .caption {
      grid-row: 1;
      grid-column: 1 / -1;
      text-align: center;
    }

    .lightbox :global(.prev) {
      grid-row: 2;
      grid-column: 1;
      justify-self: end;
      position: static;
    }

    .counter {
      grid-row: 2;
      grid-column: 2;
    }

    .lightbox :global(.next) {
      grid-row: 2;
      grid-column: 3;
      justify-self: start;
      position: static;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox {
      opacity: 0;
      transition:
        opacity 200ms ease,
        display 200ms allow-discrete,
        overlay 200ms allow-discrete;

      &[open] {
        opacity: 1;
      }

      &::backdrop {
        opacity: 0;
        transition:
          opacity 200ms ease,
          display 200ms allow-discrete,
          overlay 200ms allow-discrete;
      }

      &[open]::backdrop {
        opacity: 1;
      }
    }

    @starting-style {
      .lightbox[open] {
        opacity: 0;
      }

      .lightbox[open]::backdrop {
        opacity: 0;
      }
    }
  }
</style>
