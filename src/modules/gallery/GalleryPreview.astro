---
import { getRelativeLocaleUrl } from "astro:i18n";
import Chip from "@/lib/ui/Chip.svelte";
import { slugOf, type Gallery } from "@/modules/gallery/gallery";
import { dateFormatter } from "@/lib/dateTime";
import { COVER_WIDTHS, imagekitSrcSet, imagekitUrl } from "@/lib/imagekit";

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const { locale } = Astro.locals;

const strings = {
  en: { updated: "Updated", photos: "photos" },
  sk: { updated: "Aktualizované", photos: "fotiek" },
};
const t = strings[locale];

const fmt = dateFormatter(locale);
const slug = slugOf(gallery);
const href = getRelativeLocaleUrl(locale, `gallery/${slug}`);
const cover = gallery.data.photos[0];
---

<article>
  <div class="cover-wrap">
    <img
      src={imagekitUrl(cover.src, { width: 960 })}
      srcset={imagekitSrcSet(cover.src, COVER_WIDTHS)}
      sizes="(min-width: 44rem) 45vw, 100vw"
      fetchpriority="high"
      alt={cover.alt}
      class="cover"
      transition:name={`gallery-preview-cover-${slug}`}
    />

    <ul class="tags">
      {
        gallery.data.tags.map((tag) => (
          <li>
            <Chip>{tag}</Chip>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="seam" aria-hidden="true"></div>

  <a class="card-link" href={href} aria-hidden="true" tabindex="-1" />

  <div class="content" transition:name={`gallery-preview-meta-${slug}`}>
    <div class="meta">
      <time datetime={gallery.data.created.toISOString()}>
        {fmt.format(gallery.data.created)}
      </time>
      {
        gallery.data.updated && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              {t.updated} {fmt.format(gallery.data.updated)}
            </span>
          </>
        )
      }
      <span aria-hidden="true">·</span>
      <span>{gallery.data.photos.length} {t.photos}</span>
    </div>

    <div class="divider" aria-hidden="true"><div></div></div>

    <h2 class="title">
      <a href={href}>{gallery.data.title}</a>
    </h2>

    <p class="description">{gallery.data.description}</p>
  </div>
</article>

<style>
  article {
    position: relative;
    inline-size: 100%;
    cursor: pointer;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .cover-wrap {
    position: relative;
  }

  .cover {
    display: block;
    inline-size: 100%;
    block-size: 12rem;
    object-fit: cover;
  }

  .seam {
    block-size: 1px;
    background-color: var(--color-border);
  }

  .content {
    display: grid;
    grid-template-areas:
      "meta"
      "divider"
      "title"
      "description";
    padding: var(--space-m);
    row-gap: var(--space-xs);
  }

  .meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    color: var(--color-text-muted);
    font-family: var(--font-monospace);
    font-size: var(--text-xs);
  }

  .tags {
    position: absolute;
    inset-inline-end: var(--space-m);
    inset-block-end: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2xs);
    list-style-type: none;
    transform: translateY(50%);
  }

  .divider {
    grid-area: divider;

    div {
      block-size: 2px;
      inline-size: 3rem;
      background-color: var(--color-accent);
    }
  }

  .title {
    grid-area: title;
    font-family: var(--font-heading);
    font-size: var(--text-l);
    font-weight: var(--weight-semibold);

    a {
      transition: color 160ms ease;

      article:hover &,
      article:focus-within & {
        text-decoration: none;
        @media (prefers-reduced-motion: no-preference) {
          color: var(--color-accent);
        }
      }
    }
  }

  .description {
    grid-area: description;
    color: var(--color-text-muted);
    font-size: var(--text-s);
  }
</style>
