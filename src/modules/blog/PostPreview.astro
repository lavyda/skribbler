---
import { getRelativeLocaleUrl } from "astro:i18n";
import Chip from "@/lib/ui/Chip.svelte";
import { slugOf, readingTime, type Post } from "@/modules/blog/blog";
import { dateFormatter } from "@/lib/dateTime";
import { COVER_WIDTHS, imagekitSrcSet, imagekitUrl } from "@/lib/imagekit";

interface Props {
  post: Post;
  priority?: boolean;
  headingLevel?: "h2" | "h3";
  // Off for related-post cards: two posts that reference each other (a
  // parent/child pair) each embed a card keyed by the other's slug, which
  // collides with that other post's own hero transition:name on its own
  // page. Dropping transition:name isn't enough on its own — Astro still
  // auto-pairs same-type elements by DOM position, producing a stray
  // slide — so transition:animate="none" is also disabled here.
  linkTransition?: boolean;
}

const {
  post,
  priority = false,
  headingLevel = "h2",
  linkTransition = true,
} = Astro.props;
const { locale } = Astro.locals;
const Heading = headingLevel;

const strings = {
  en: { min: "min read", updated: "Updated" },
  sk: { min: "min čítania", updated: "Aktualizované" },
};
const t = strings[locale];

const fmt = dateFormatter(locale);
const slug = slugOf(post);
const href = getRelativeLocaleUrl(locale, `blog/${slug}`);
---

<article transition:animate={linkTransition ? undefined : "fade"}>
  {
    post.data.cover && (
      <div class="cover-wrap">
        <img
          src={imagekitUrl(post.data.cover, { width: 960 })}
          srcset={imagekitSrcSet(post.data.cover, COVER_WIDTHS)}
          sizes="(min-width: 44rem) 45vw, 100vw"
          fetchpriority={priority ? "high" : "auto"}
          loading={priority ? "eager" : "lazy"}
          decoding={priority ? "sync" : "async"}
          alt={post.data.coverAlt ?? ""}
          class="cover"
          transition:name={
            linkTransition ? `post-preview-cover-${slug}` : undefined
          }
          transition:animate={linkTransition ? undefined : "fade"}
        />

        <ul class="tags floating">
          {
            post.data.tags.map((tag) => (
              <li>
                <Chip>{tag}</Chip>
              </li>
            ))
          }
        </ul>
      </div>
    )
  }

  {post.data.cover && <div class="seam" aria-hidden="true" />}

  <a class="card-link" href={href} aria-hidden="true" tabindex="-1"></a>

  <div
    class="content"
    transition:name={
      linkTransition ? `post-preview-meta-${slug}` : undefined
    }
    transition:animate={linkTransition ? undefined : "fade"}
  >
    <div class="meta">
      <time datetime={post.data.created.toISOString()}>
        {fmt.format(post.data.created)}
      </time>
      {
        post.data.updated && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              {t.updated} {fmt.format(post.data.updated)}
            </span>
          </>
        )
      }
      <span aria-hidden="true">·</span>
      <span>
        {readingTime(post.body)}
        {t.min}
      </span>
    </div>

    {
      !post.data.cover && (
        <ul class="tags inline">
          {post.data.tags.map((tag) => (
            <li>
              <Chip>{tag}</Chip>
            </li>
          ))}
        </ul>
      )
    }

    <div class="divider" aria-hidden="true"><div></div></div>

    <Heading class="title">
      <a href={href}>{post.data.title}</a>
    </Heading>

    <p class="description">{post.data.description}</p>
  </div>
</article>

<style>
  article {
    container-type: inline-size;
    position: relative;
    inline-size: 100%;
    block-size: 100%;
    cursor: pointer;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .cover-wrap {
    position: relative;
  }

  .cover {
    display: block;
    inline-size: 100%;
    block-size: 12rem;
    object-fit: cover;
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
  }

  .seam {
    block-size: 1px;
    background-color: var(--color-border);
  }

  .content {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "meta tags"
      "divider divider"
      "title title"
      "description description";
    padding: var(--space-m);
    row-gap: var(--space-xs);
    column-gap: var(--space-m);
  }

  article:has(.cover-wrap) .content {
    grid-template-columns: 1fr;
    grid-template-areas:
      "meta"
      "divider"
      "title"
      "description";
  }

  @container (width < 28rem) {
    .content {
      grid-template-columns: 1fr;
      grid-template-areas:
        "meta"
        "tags"
        "divider"
        "title"
        "description";
    }

    article:has(.cover-wrap) .content {
      grid-template-areas:
        "meta"
        "divider"
        "title"
        "description";
    }
  }

  .meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    color: var(--color-text-muted);
    font-family: var(--font-monospace);
    font-size: var(--text-xs);
  }

  .tags.inline {
    grid-area: tags;
    justify-self: start;
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: var(--space-2xs);
    padding: 0;
    list-style-type: none;

    /* Without an explicit width, li ends up sized to the flex line
       instead of its content in this nested grid/flex/container-query
       combination — cause unclear, but content-based sizing is what's
       wanted here. */
    li {
      width: fit-content;
    }
  }

  .tags.floating {
    position: absolute;
    inset-inline-end: var(--space-m);
    inset-block-end: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2xs);
    padding: 0;
    list-style-type: none;
    transform: translateY(50%);

    li {
      width: fit-content;
    }
  }

  .divider {
    grid-area: divider;

    div {
      block-size: 2px;
      inline-size: 3rem;
      background-color: var(--color-accent);
    }
  }

  .title {
    grid-area: title;
    font-family: var(--font-heading);
    font-size: var(--text-l);
    font-weight: var(--weight-semibold);

    a {
      transition: color 160ms ease;

      article:hover &,
      article:focus-within & {
        text-decoration: none;
        @media (prefers-reduced-motion: no-preference) {
          color: var(--color-accent);
        }
      }
    }
  }

  .description {
    grid-area: description;
    color: var(--color-text-muted);
    font-size: var(--text-s);
  }
</style>
