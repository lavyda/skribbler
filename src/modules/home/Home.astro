---
import Earth from "@/lib/ui/Earth.svelte";

const { locale } = Astro.locals;

const strings = {
  en: {
    roles: { developer: "Software developer", nomad: "Nomadic creator" },
    bio: {
      build: "I build software for a living,",
      design: "design for the human experience,",
      capture: "and capture the world through a lens",
      remember: "just for the joy of it.",
    },
    location: "Based in Slovakia",
    building: "Currently crafting at",
    findMe: "Find me on",
    say: "Say",
  },
  sk: {
    roles: { developer: "Softvérový vývojár", nomad: "Tvorca na cestách" },
    bio: {
      build: "Venujem sa tvorbe softvéru,",
      design: "robím dizajn pre ľudí,",
      capture: "a zachytávam svet cez objektív,",
      remember: "lebo ma to baví.",
    },
    location: "Sídlim na Slovensku",
    building: "Momentálne tvorím vo",
    findMe: "Nájdeš ma na",
    say: "Napíš na",
  },
};
const t = strings[locale as keyof typeof strings];
---

<div class="home">
  <h1>
    <span>{t.roles.developer}</span>
    <span aria-hidden="true">·</span>
    <span>{t.roles.nomad}</span>
  </h1>

  <div class="bio">
    <div>{t.bio.build}</div>
    <div>{t.bio.design}</div>
    <div>{t.bio.capture}</div>
    <div>{t.bio.remember}</div>
  </div>

  <div class="details">
    <div>{t.location}</div>
    <div>
      {t.building}
      <span> </span>
      <a href="https://visma.com">Visma Labs</a>
    </div>
    <div>
      {t.findMe}
      <span> </span>
      <a href="https://instagram.com/ja.vlado">Instagram</a> · <a
        href="https://github.com/lavyda">Github</a
      >
    </div>
    <div>
      {t.say}
      <span> </span>
      <a href="mailto:hi@kovalsky.sk">hi@kovalsky.sk</a>
    </div>
  </div>

  <div class="backdrop" aria-hidden="true" transition:persist="earth">
    <Earth client:idle color="var(--color-accent)" />
  </div>
</div>

<style>
  .home {
    isolation: isolate;
    padding-block-start: var(--space-3xl);

    @media screen and (width < 40rem) {
      padding-block-start: 0;
    }
  }

  h1 {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-family: var(--font-monospace);
    font-size: var(--text-m);
    font-weight: var(--weight-normal);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .bio {
    margin-block: var(--space-xl);
    font-size: var(--text-3xl);

    & > div:nth-child(2) {
      opacity: 0.85;
    }

    & > div:nth-child(3) {
      opacity: 0.75;
    }

    & > div:nth-child(4) {
      opacity: 0.65;
    }
  }

  .details {
    inline-size: min(50ch, 100%);
    display: grid;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    font-family: var(--font-monospace);
    border-top: 1px solid var(--color-border);
    padding-block-start: var(--space-m);
  }

  .backdrop {
    position: fixed;
    z-index: -1;
    right: clamp(-8rem, -6vw, -3rem);
    bottom: clamp(-8rem, -6vw, -3rem);
    inline-size: clamp(22rem, 55vw, 48rem);
    aspect-ratio: 1;
    pointer-events: none;
  }
</style>
