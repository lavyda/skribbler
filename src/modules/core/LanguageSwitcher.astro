---
import { getRelativeLocaleUrl } from "astro:i18n";
import Button from "@/lib/ui/Button.svelte";

const { locale, locales } = Astro.locals;

const target = locales.find((l) => l !== locale) ?? locale;

const segments = Astro.url.pathname.split("/").filter(Boolean);
if (locales.some((l) => l === segments[0])) {
  segments.shift();
}
const href = getRelativeLocaleUrl(target, segments.join("/"));

const strings = {
  en: {
    changeLanguage: "Change language to",
    en: "English",
    sk: "Slovak",
  },
  sk: {
    changeLanguage: "Zmeniť jazyk na",
    en: "angličtinu",
    sk: "slovenčinu",
  },
};
const t = strings[locale as keyof typeof strings];
---

<Button
  variant="ghost"
  link
  href={href}
  title={`${t.changeLanguage} ${t[target]}`}
>
  {target.toUpperCase()}
</Button>
