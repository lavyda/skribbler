---
import { sectionUrl, type Alternates } from "@/lib/i18n";

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;
import Button from "@/lib/ui/Button.svelte";

const { locale, locales } = Astro.locals;

const target = locales.find((l) => l !== locale) ?? locale;

// No translation: land on the section index instead of a 404.
const href = alternates[target] ?? sectionUrl(target, Astro.url.pathname);

const strings = {
  en: {
    changeLanguage: "Change language to",
    en: "English",
    sk: "Slovak",
  },
  sk: {
    changeLanguage: "Zmeniť jazyk na",
    en: "angličtinu",
    sk: "slovenčinu",
  },
};
const t = strings[locale as keyof typeof strings];
---

<Button
  variant="ghost"
  link
  href={href}
  data-choose-locale={target}
  title={`${t.changeLanguage} ${t[target]}`}
>
  {target.toUpperCase()}
</Button>
