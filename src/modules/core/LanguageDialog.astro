---
import { sectionUrl, type Alternates } from "@/lib/i18n";
import Button from "@/lib/ui/Button.svelte";
import Icon from "@/lib/ui/Icon.svelte";
import X from "@/lib/ui/icons/X.svelte";

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;
const { locale, locales } = Astro.locals;

// The offer is shown in both languages: the visitor's guessed one and the page's own.
const strings = {
  en: {
    name: "English",
    available: "This page is available in English.",
    also: "This page is also available in",
    languages: { en: "English", sk: "Slovak" },
    stay: "Stay here",
    close: "Close",
  },
  sk: {
    name: "Slovenčina",
    available: "Táto stránka je dostupná po slovensky.",
    also: "Táto stránka je dostupná aj po",
    languages: { en: "anglicky", sk: "slovensky" },
    stay: "Zostať tu",
    close: "Zavrieť",
  },
};
type Strings = typeof strings;
const current = strings[locale as keyof Strings];
---

<dialog id="lang-dialog" closedby="none">
  {locales
    .filter((l) => l !== locale)
    .map((l) => {
      const offered = strings[l as keyof Strings];
      return (
        <form method="dialog" id={`lang-offer-${l}`} hidden>
          <Button
            variant="ghost"
            icon
            type="submit"
            class="close"
            aria-label={`${offered.close} / ${current.close}`}
          >
            <Icon glyph={X} />
          </Button>
          <p id={`lang-offer-${l}-a`} lang={l}>
            {offered.available}
          </p>
          <p id={`lang-offer-${l}-b`} lang={locale}>
            {current.also}{" "}
            {current.languages[l as keyof Strings["en"]["languages"]]}.
          </p>
          <div class="actions">
            <Button variant="secondary" type="submit">
              <span lang={l}>{offered.stay}</span>
              <span aria-hidden="true">/</span>
              <span lang={locale}>{current.stay}</span>
            </Button>
            <Button
              link
              href={alternates[l] ?? sectionUrl(l, Astro.url.pathname)}
              data-choose-locale={l}
              autofocus
            >
              <span lang={l}>{offered.name}</span>
            </Button>
          </div>
        </form>
      );
    })}
</dialog>

<script>
  import {
    dismiss,
    isDismissed,
    preferred,
    save,
  } from "@/lib/localePreference";

  document.addEventListener("click", (event) => {
    const target = event.target as Element;

    // Saves an explicit choice from the header switcher or the dialog.
    const chosen = target.closest<HTMLElement>("[data-choose-locale]")?.dataset
      .chooseLocale;
    if (chosen) save(chosen);
  });

  document.addEventListener("astro:page-load", () => {
    const dialog = document.querySelector<HTMLDialogElement>("#lang-dialog");
    if (!dialog || dialog.open) return;

    const current = document.documentElement.lang;
    const wanted = preferred();
    if (!wanted || wanted === current || isDismissed(wanted)) return;

    dialog.querySelector<HTMLElement>(`#lang-offer-${wanted}`)!.hidden = false;
    dialog.setAttribute(
      "aria-labelledby",
      `lang-offer-${wanted}-a lang-offer-${wanted}-b`,
    );
    // Only a button closes it. closedby="none" covers Esc and backdrop clicks;
    // cancel covers browsers without closedby support.
    dialog.addEventListener("cancel", (event) => event.preventDefault());
    // Closing via Stay or the close button counts as dismissing.
    dialog.addEventListener("close", () => dismiss(wanted), { once: true });
    dialog.showModal();
  });
</script>

<style>
  dialog {
    margin: auto;
    padding: var(--space-2xl);
    inline-size: min(36rem, calc(100% - 2 * var(--space-l)));
    background-color: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    font-size: var(--text-m);
    line-height: var(--line-height-reading);
    text-align: center;
  }

  dialog::backdrop {
    background-color: color-mix(in oklab, var(--color-bg) 70%, transparent);
    backdrop-filter: blur(3px);
  }

  form {
    display: grid;
    gap: var(--space-xs);
  }

  form :global(.close) {
    position: absolute;
    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
  }

  p {
    margin: 0;
  }

  p:first-of-type {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  p + p {
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }
</style>
