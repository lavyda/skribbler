---
import { sectionUrl, type Alternates } from "@/lib/i18n";
import Button from "@/lib/ui/Button.svelte";

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;
const { locale, locales } = Astro.locals;

// The offer is shown in both languages: the visitor's guessed one and the page's own.
const strings = {
  en: {
    name: "English",
    available: "This page is available in English.",
    also: "This page is also available in",
    languages: { en: "English", sk: "Slovak" },
    stay: "Stay here",
  },
  sk: {
    name: "Slovenčina",
    available: "Táto stránka je dostupná po slovensky.",
    also: "Táto stránka je dostupná aj po",
    languages: { en: "anglicky", sk: "slovensky" },
    stay: "Zostať tu",
  },
};
type Strings = typeof strings;
const current = strings[locale as keyof Strings];
---

<dialog id="lang-dialog">
  {
    locales
      .filter((l) => l !== locale)
      .map((l) => {
        const offered = strings[l as keyof Strings];
        return (
          <form method="dialog" id={`lang-offer-${l}`} hidden>
            <p id={`lang-offer-${l}-a`} lang={l}>
              {offered.available}
            </p>
            <p id={`lang-offer-${l}-b`} lang={locale}>
              {current.also} {current.languages[l as keyof Strings["en"]["languages"]]}.
            </p>
            <div class="actions">
              <Button
                link
                href={alternates[l] ?? sectionUrl(l, Astro.url.pathname)}
                data-choose-locale={l}
              >
                <span lang={l}>{offered.name}</span>
              </Button>
              <Button variant="secondary" type="submit" autofocus>
                <span lang={l}>{offered.stay}</span>
                <span aria-hidden="true">/</span>
                <span lang={locale}>{current.stay}</span>
              </Button>
            </div>
          </form>
        );
      })
  }
</dialog>

<script>
  import { dismiss, isDismissed, preferred, save } from "@/lib/localePreference";

  document.addEventListener("click", (event) => {
    const target = event.target as Element;

    // Saves an explicit choice from the header switcher or the dialog.
    const chosen = target.closest<HTMLElement>("[data-choose-locale]")?.dataset
      .chooseLocale;
    if (chosen) save(chosen);

    // A click on the backdrop lands on the dialog element itself, outside its box.
    if (target instanceof HTMLDialogElement && target.open) {
      const box = target.getBoundingClientRect();
      const { clientX: x, clientY: y } = event as MouseEvent;
      if (x < box.left || x > box.right || y < box.top || y > box.bottom) {
        target.close();
      }
    }
  });

  document.addEventListener("astro:page-load", () => {
    const dialog = document.querySelector<HTMLDialogElement>("#lang-dialog");
    if (!dialog || dialog.open) return;

    const current = document.documentElement.lang;
    const wanted = preferred();
    if (!wanted || wanted === current || isDismissed(wanted)) return;

    dialog.querySelector<HTMLElement>(`#lang-offer-${wanted}`)!.hidden = false;
    dialog.setAttribute(
      "aria-labelledby",
      `lang-offer-${wanted}-a lang-offer-${wanted}-b`,
    );
    // Stay, Esc and backdrop click all close the dialog: that counts as dismissing.
    dialog.addEventListener("close", () => dismiss(wanted), { once: true });
    dialog.showModal();
  });
</script>

<style>
  dialog {
    margin: auto;
    padding: var(--space-2xl);
    inline-size: min(36rem, calc(100% - 2 * var(--space-l)));
    background-color: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    font-size: var(--text-m);
    line-height: var(--line-height-reading);
    text-align: center;
  }

  dialog::backdrop {
    background-color: color-mix(in oklab, var(--color-bg) 70%, transparent);
    backdrop-filter: blur(3px);
  }

  form {
    display: grid;
    gap: var(--space-xs);
  }

  p {
    margin: 0;
  }

  p:first-child {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  p + p {
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }
</style>
