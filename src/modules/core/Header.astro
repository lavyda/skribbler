---
import { getRelativeLocaleUrl } from "astro:i18n";
import Navigation from "./Navigation.astro";
import ThemeSwitcher from "./ThemeSwitcher.svelte";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { locale } = Astro.locals;

const strings = {
  en: {
    theme: { light: "light mode", dark: "dark mode", changeTo: "Change to" },
    name: "Vladimír",
    surname: "Kovalský",
  },
  sk: {
    theme: { light: "svetlý", dark: "tmavý", changeTo: "Zmeniť vzhľad na" },
    name: "Vladimír",
    surname: "Kovalský",
  },
};
const t = strings[locale as keyof typeof strings];
---

<header>
  <a href={getRelativeLocaleUrl(locale, "")}
    ><span>{t.name}</span> <span>{t.surname}</span>
  </a>
  <Navigation />
  <LanguageSwitcher />
  <ThemeSwitcher client:load labels={t.theme} />
</header>

<style>
  header {
    z-index: 10;
    padding: clamp(1rem, 0.826rem + 0.87vw, 1.5rem)
      clamp(1.5rem, 0.63rem + 4.348vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3xs);
    background-color: var(--color-bg);

    > a:first-child {
      margin-inline-end: auto;
      text-decoration: none;
      font-size: var(--text-xl);
      font-family: var(--font-heading);
      letter-spacing: var(--space-3xs);
      text-transform: uppercase;

      > span:first-child {
        font-weight: var(--weight-semibold);
      }
      > span:last-child {
        font-style: italic;
      }

      @media screen and (width < 40rem) {
        font-size: var(--text-m);
      }
    }
  }
</style>
