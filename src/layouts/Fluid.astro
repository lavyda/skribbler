---
import Base from "./Base.astro";
import type { Alternates } from "@/lib/i18n";

interface Props {
	title?: string;
	alternates?: Alternates;
}

const { title, alternates } = Astro.props;
---

<Base {title} {alternates}>
	<main>
		<slot />
	</main>
</Base>

<style>
	main {
		padding: var(--space-l) var(--space-3xl);
	}
</style>
